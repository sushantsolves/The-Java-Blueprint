      "link": null,
      "locked": false,
      "text": "int nums[] = new int[4];        \n        //here the array is a object(as \"new\" keyword comes), it will stored in continuous in heap memory\n        // Now bcz of the continuous memory, we can't increase its size. only we have option left is to create a new one and copy all data.\n\n\n        // Also it has a feature to store only same type of data. \n        // Now to tackle that issue, we have a new thing in game which is know as \"Collection\" (Discussed later).\n\n\n        // Also It doesn't mean we are going to stop using array or something else, arrays will be the first preference if we know the storage type and no. of elements, and also array is known for its speed.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int nums[] = new int[4];        \n        //here the array is a object(as \"new\" keyword comes), it will stored in continuous in heap memory\n        // Now bcz of the continuous memory, we can't increase its size. only we have option left is to create a new one and copy all data.\n\n\n        // Also it has a feature to store only same type of data. \n        // Now to tackle that issue, we have a new thing in game which is know as \"Collection\" (Discussed later).\n\n\n        // Also It doesn't mean we are going to stop using array or something else, arrays will be the first preference if we know the storage type and no. of elements, and also array is known for its speed.\n",
      "autoResize": true,
      "lineHeight": 1.25
    }
