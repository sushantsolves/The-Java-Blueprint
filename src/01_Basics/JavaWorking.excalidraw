    {
      "id": "gh7tORS-sTT7slWngqOge",
      "type": "text",
      "x": 780.2267416913082,
      "y": 91.83472231071846,
      "width": 1909.5589599609375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 600913243,
      "version": 887,
      "versionNonce": 373377525,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786552914813,
      "link": null,
      "locked": false,
      "text": "Execute the files from our system (bytecode), but out of thousands of files, which file to run? the file which you specify and that file should contain \"main\" and the execution starts from there.\nand also not only main, it is looking for a specific signature (public static void main) and also some args and parameters(string arg[]).\n--> We will discuss them later. \n--> Also JVM is different for different OS's (that's why it is platform Independent)8\n--> Why Virtual Machine? As it behaves like a machine inside your computer but it is a software, not a physical machine.\n \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Execute the files from our system (bytecode), but out of thousands of files, which file to run? the file which you specify and that file should contain \"main\" and the execution starts from there.\nand also not only main, it is looking for a specific signature (public static void main) and also some args and parameters(string arg[]).\n--> We will discuss them later. \n--> Also JVM is different for different OS's (that's why it is platform Independent)8\n--> Why Virtual Machine? As it behaves like a machine inside your computer but it is a software, not a physical machine.\n \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
